# =============================================================================
# Tariq AI — Combined env reference
# =============================================================================
# This file is a single-page reference for DevOps. It shows every env var
# across the three real env files. Do NOT copy it wholesale into one place —
# split it into its three target files as marked below:
#
#   Section 1  →  backend/.env          (FastAPI runtime)
#   Section 2  →  backend/.env.docker   (Keycloak compose + bootstrap)
#   Section 3  →  frontend/.env.local   (Next.js server + public runtime)
#
# Lines prefixed with `# REQUIRED` must be set explicitly in production.
# All others have sensible defaults baked into the code/compose.
# =============================================================================
#
# PORT MAP — change all four together when deploying behind shared infra:
#
#   Service       | Default | Env var (file)                          | URLs that must match
#   --------------|---------|------------------------------------------|---------------------------------------------
#   FastAPI       | 8000    | PORT (backend/.env)                      | frontend FASTAPI_URL
#   Next.js       | 3000    | PORT (frontend/.env.local)               | backend APP_ORIGIN, NEXT_PUBLIC_APP_ORIGIN
#   Keycloak      | 8080    | KC_PORT (backend/.env.docker)            | KEYCLOAK_ISSUER (backend + frontend)
#   Postgres (KC) | 5432    | not exposed — internal compose network   | n/a
#
# Example for a server already running other services on 8000/3000/8080:
#   backend/.env             PORT=8200,  KEYCLOAK_ISSUER=http://localhost:8280/realms/tariq
#   frontend/.env.local      PORT=3200,  FASTAPI_URL=http://localhost:8200/api/v1
#                                        NEXT_PUBLIC_APP_ORIGIN=http://localhost:3200
#                                        KEYCLOAK_ISSUER=http://localhost:8280/realms/tariq
#   backend/.env.docker      KC_PORT=8280, APP_ORIGIN=http://localhost:3200
# =============================================================================


# -----------------------------------------------------------------------------
# SECTION 1 — backend/.env
# -----------------------------------------------------------------------------
# Consumed by FastAPI (pydantic-settings → app/config.py). Drives JWT
# validation + DB connection.

# HTTP bind port for uvicorn/gunicorn. Default 8000.
PORT=8000

# Database — PostgreSQL for prod, SQLite for dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tariq
# DATABASE_URL=sqlite+aiosqlite:///./tariq.db

# REQUIRED — Keycloak realm issuer. Must equal frontend KEYCLOAK_ISSUER.
# Format: <scheme>://<KC_HOSTNAME>/realms/<REALM_NAME>
KEYCLOAK_ISSUER=http://localhost:8080/realms/tariq

# Must equal compose AUDIENCE (Section 2).
KEYCLOAK_AUDIENCE=tariq-api

# Seconds between JWKS refetches. Raise in prod for fewer round-trips.
KEYCLOAK_JWKS_CACHE_TTL=3600

# Token `exp` leeway in seconds (clock skew tolerance).
KEYCLOAK_CLOCK_SKEW=10

# JSON array of allowed origins for CORS. In prod, include the real
# frontend origin(s) — e.g. ["https://app.example.com"].
CORS_ORIGINS=["http://localhost:3000"]


# -----------------------------------------------------------------------------
# SECTION 2 — backend/.env.docker
# -----------------------------------------------------------------------------
# Consumed by docker-compose + the one-shot keycloak-bootstrap service.
# This file drives Keycloak's DB, admin user, realm, client, and (optionally)
# a dev user.

# ---- Keycloak Postgres ----
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
# REQUIRED — strong password in prod, managed by a real secret store.
KC_DB_PASSWORD=change-me-to-a-strong-password

# ---- Keycloak master-realm admin ----
# REQUIRED
KC_ADMIN_USER=admin
# REQUIRED — rotate after first login.
KC_ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- Deployment-specific (override in prod) ----
# Real domain in prod, e.g. keycloak.example.com
KC_HOSTNAME=localhost
# Strict hostname checking — "true" in prod
KC_HOSTNAME_STRICT=false
# Host-side Keycloak port. Override on shared servers; container always 8080.
KC_PORT=8080
# Frontend public origin; used for OIDC redirect URIs + web origins.
# Must equal frontend NEXT_PUBLIC_APP_ORIGIN (incl. port).
APP_ORIGIN=http://localhost:3000

# ---- Realm config (keep in sync across backend + frontend) ----
REALM_NAME=tariq
CLIENT_ID=tariq-web
AUDIENCE=tariq-api

# ---- Dev-only bootstrap user ----
# When true, bootstrap.sh auto-creates a user with the credentials below.
# MUST be "false" in production.
CREATE_DEV_USER=true
DEV_USER_EMAIL=demo@example.com
DEV_USER_PASSWORD=ChangeMe123!
# "user" or "admin"
DEV_USER_ROLE=admin


# -----------------------------------------------------------------------------
# SECTION 3 — frontend/.env.local
# -----------------------------------------------------------------------------
# Consumed by Next.js. Server-only unless prefixed with NEXT_PUBLIC_, which
# ships to the browser.

# HTTP bind port for `next dev` / `next start`. Default 3000.
PORT=3000

# REQUIRED — Dify API key. Server-only, NEVER exposed to the client.
DIFY_API_KEY=app-your-api-key-here
# REQUIRED — Dify API base, e.g. https://dify.novin-dev.com/v1
DIFY_BASE_URL=https://dify.novin-dev.com/v1

# REQUIRED — Backend URL. Use an in-cluster hostname in prod
# (e.g. http://backend:8000) or a public HTTPS URL.
FASTAPI_URL=http://localhost:8000

# REQUIRED — Keycloak realm issuer. Must equal backend KEYCLOAK_ISSUER.
KEYCLOAK_ISSUER=http://localhost:8080/realms/tariq

# Must equal compose CLIENT_ID (Section 2).
KEYCLOAK_CLIENT_ID=tariq-web

# REQUIRED — public URL of this app. Ships to the browser.
# Must equal compose APP_ORIGIN (Section 2).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# ---- Embed widget (anonymous, script-tag deployment) ----
# Comma-separated allowlist of widget app IDs. Each must resolve a Dify key
# via DIFY_API_KEY_<UPPER> (fallback DIFY_API_KEY).
EMBED_APPS=support,sales
# Per-app Dify keys (one per id in EMBED_APPS):
DIFY_API_KEY_SUPPORT=
DIFY_API_KEY_SALES=
# Optional per-app Dify base URL override:
# DIFY_BASE_URL_SUPPORT=
# Comma-separated host origins allowed to iframe /embed/* (frame-ancestors CSP).
EMBED_ALLOWED_HOSTS=https://acme.com,http://localhost:3001

# ---- Embed widget — host-site Keycloak handoff (optional) ----
# When the host site has an authenticated Keycloak user, it can hand its
# access token to the widget via window.Tariq.setTokenProvider(...). The
# embed route verifies the token and uses kc_<sub> as the Dify user id.
# Leave both vars unset for anonymous-only widget deployments.
# EMBED_KEYCLOAK_ISSUER=https://auth.acme.com/realms/acme
# EMBED_KEYCLOAK_AUDIENCE=tariq-widget,acme-web
# Per-app required-auth flag — listed apps reject unauthed widget requests.
# EMBED_REQUIRE_AUTH=support,sales


# =============================================================================
# Cross-file invariants DevOps must hold
# =============================================================================
#
#   backend/.env KEYCLOAK_ISSUER      == frontend/.env.local KEYCLOAK_ISSUER
#   backend/.env KEYCLOAK_AUDIENCE    == .env.docker AUDIENCE
#   frontend KEYCLOAK_CLIENT_ID       == .env.docker CLIENT_ID
#   frontend NEXT_PUBLIC_APP_ORIGIN   == .env.docker APP_ORIGIN
#   .env.docker KC_PORT               == port inside KEYCLOAK_ISSUER (both files)
#   backend PORT                      == port inside frontend FASTAPI_URL
#   frontend PORT                     == port inside NEXT_PUBLIC_APP_ORIGIN + APP_ORIGIN
#
# In production, also:
#   - CREATE_DEV_USER=false
#   - KC_HOSTNAME = real domain, KC_HOSTNAME_STRICT=true
#   - KC_DB_PASSWORD and KC_ADMIN_PASSWORD are strong values from a secret store
#   - backend CORS_ORIGINS includes the real frontend origin
# =============================================================================
