# =============================================================================
# frontend/.env.local  —  Next.js runtime config (gitignored when copied)
# =============================================================================
# Server-only by default. Variables prefixed with NEXT_PUBLIC_ ship to the
# browser, so never put secrets behind that prefix.

# ---- HTTP server ----
# Bind port for `next dev` and `next start`. Next.js reads $PORT natively.
# Override on shared hosts. When changed, also update NEXT_PUBLIC_APP_ORIGIN
# below AND backend APP_ORIGIN (.env.docker) so Keycloak redirect URIs match.
PORT=3000

# ---- Dify (chat AI) ----
# REQUIRED — Dify API key. Server-only, NEVER exposed to the client.
# All chat traffic is proxied through /api/chat/* routes.
DIFY_API_KEY=app-your-api-key-here
# REQUIRED — Dify API base URL.
DIFY_BASE_URL=https://dify.novin-dev.com/v1

# ---- Auth provider ----
# "keycloak" (default) | "sqlite". When "sqlite", the backend's local
# email+password auth is used instead of OIDC; login/register pages render
# credential forms that POST to the local /api/auth/{login,register} routes,
# which proxy to FASTAPI_URL/auth/{login,register}. AUTH_JWT_SECRET must
# match the backend's value, and AUTH_JWT_ISSUER / AUTH_JWT_AUDIENCE must
# match the backend's `iss` / `aud` claims.
#
# This variable is NEXT_PUBLIC_ because the browser-side login/register
# components branch UI on it. The other AUTH_JWT_* values are server-only
# and are read by /api/chat/messages when verifying the access token.
NEXT_PUBLIC_AUTH_PROVIDER=keycloak
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=tariq-backend
AUTH_JWT_AUDIENCE=tariq-api

# ---- Auth backend (FastAPI) ----
# REQUIRED — Backend URL including the API prefix. Must match the backend's
# API_PREFIX setting (default "/api/v1"). For a subpath deployment like
# API_PREFIX=/tariqrag, set FASTAPI_URL=https://backend.example.com/tariqrag.
# In-cluster example: http://backend:8000/api/v1
FASTAPI_URL=http://localhost:8000/api/v1

# ---- Keycloak (OIDC) ----
# REQUIRED — Keycloak realm issuer. Must be IDENTICAL to backend/.env value.
KEYCLOAK_ISSUER=http://localhost:8080/realms/tariq

# Public OIDC client ID. Must equal CLIENT_ID in backend/.env.docker.
KEYCLOAK_CLIENT_ID=tariq-web

# REQUIRED — Public URL of this app. Ships to the browser (NEXT_PUBLIC_).
# Must equal APP_ORIGIN in backend/.env.docker — Keycloak uses it to
# compute valid redirect URIs and web origins.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Embed widget (anonymous, script-tag deployment)
# ---------------------------------------------------------------------------

# Comma-separated list of valid app IDs. Each must resolve a Dify API key
# via DIFY_API_KEY_<ID> (uppercase snake) or fall back to DIFY_API_KEY.
EMBED_APPS=support,sales

# Per-app Dify API key. Fallback to DIFY_API_KEY if unset.
DIFY_API_KEY_SUPPORT=
DIFY_API_KEY_SALES=

# Optional per-app base URL override (falls back to DIFY_BASE_URL).
# DIFY_BASE_URL_SUPPORT=

# Comma-separated list of host origins allowed to embed the /embed iframe.
# Used by proxy.ts to emit a `frame-ancestors` CSP header. Include scheme +
# host (+ port if non-default). Example: https://novin-dev.com,http://localhost:3001
EMBED_ALLOWED_HOSTS=http://localhost:3001

# ---------------------------------------------------------------------------
# Embed widget — host-site Keycloak handoff (optional)
# ---------------------------------------------------------------------------
# When the host site has an authenticated Keycloak user, it can hand its
# access token to the widget via window.Tariq.setTokenProvider(...). The
# /api/chat/embed/messages route verifies the token and uses kc_<sub> as the
# Dify user id instead of the anon_<uuid>.
#
# Leave both vars unset to keep the widget anonymous-only.

# Issuer URL of the host site's Keycloak realm (typically NOT Tariq's main
# realm — the host runs its own).
# EMBED_KEYCLOAK_ISSUER=https://auth.acme.com/realms/acme

# Comma-separated list of acceptable `aud` values on the host's access token.
# Usually the host's Keycloak client id; or add a dedicated audience mapper
# that injects "tariq-widget".
# EMBED_KEYCLOAK_AUDIENCE=tariq-widget,acme-web

# Per-app authentication requirement. Apps in this list reject unauthed
# widget requests with a 401. Apps NOT listed keep working anonymously.
# EMBED_REQUIRE_AUTH=support,sales
