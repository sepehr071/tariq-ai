# =====================================================================
#  WARNING: bootstrap.sh refuses to run if any password below is left as
#  the placeholder __GENERATE_RANDOM_32_CHAR_PASSWORD__ (or the legacy
#  values 'change-me', 'change-me-to-a-strong-password', 'dev-admin-pw',
#  'admin'). Generate strong random secrets before `docker compose up`.
#
#  Suggested one-liner:  openssl rand -base64 32
# =====================================================================

# ---- Keycloak Postgres ----
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
# Replace placeholder before running. Bootstrap script will refuse to start otherwise.
KC_DB_PASSWORD=__GENERATE_RANDOM_32_CHAR_PASSWORD__

# ---- Keycloak admin (first-run only; rotate after first login) ----
KC_ADMIN_USER=admin
# Replace placeholder before running. Bootstrap script will refuse to start otherwise.
KC_ADMIN_PASSWORD=__GENERATE_RANDOM_32_CHAR_PASSWORD__

# ---- Deployment-specific (override in prod) ----
# Real domain in prod, e.g. keycloak.example.com
KC_HOSTNAME=localhost
# Strict hostname checking — set to "true" in prod
KC_HOSTNAME_STRICT=false
# Host-side Keycloak port. Override on shared servers running multiple stacks.
# When changed: also update KEYCLOAK_ISSUER (backend/.env) and KEYCLOAK_ISSUER
# (frontend/.env.local) to use the same port.
KC_PORT=8080
# Frontend public origin; used to compute redirect URIs + web origins.
# Must include port if non-default (e.g. http://localhost:3010).
APP_ORIGIN=http://localhost:3000

# ---- Realm config (rarely changed; keep in sync with backend/.env + frontend/.env.local) ----
REALM_NAME=tariq
CLIENT_ID=tariq-web
AUDIENCE=tariq-api

# ---- Dev-only bootstrap user ----
# When true, bootstrap.sh auto-creates a user with the credentials below.
# MUST be "false" in production. Bootstrap will refuse to run if true while
# KC_HOSTNAME is anything other than localhost / 127.0.0.1 / unset, or if
# DEV_USER_PASSWORD is left as the documented default 'ChangeMe123!'.
CREATE_DEV_USER=true
DEV_USER_EMAIL=demo@example.com
# Replace before enabling CREATE_DEV_USER. Bootstrap rejects the literal default below.
DEV_USER_PASSWORD=__GENERATE_RANDOM_32_CHAR_PASSWORD__
# "user" or "admin"
DEV_USER_ROLE=admin
