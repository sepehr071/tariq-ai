# =============================================================================
# backend/.env  —  FastAPI runtime config (gitignored when copied to .env)
# =============================================================================
# Consumed by pydantic-settings via app/config.py. Drives JWT validation
# and the database connection. For the Keycloak compose/bootstrap config,
# see .env.docker.example.

# ---- HTTP server ----
# Bind port for uvicorn/gunicorn. Override on shared hosts where 8000 is taken.
# When changed: update frontend FASTAPI_URL to match (and any reverse-proxy config).
PORT=8000

# ---- API routing ----
# Router prefix for all backend endpoints (incl. /docs, /redoc, /openapi.json).
# Must start with "/" and have no trailing slash. When changed, the frontend's
# FASTAPI_URL must include the same suffix.
# Example for a DevOps-requested subpath deployment: API_PREFIX=/tariqrag
API_PREFIX=/api/v1

# ---- Database ----
# PostgreSQL for prod, SQLite for dev. Alembic migrations run on startup
# against PostgreSQL only.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tariq
# DATABASE_URL=sqlite+aiosqlite:///./tariq.db

# ---- Keycloak JWT validation ----
# REQUIRED — Keycloak realm issuer.
# Format: <scheme>://<KC_HOSTNAME>/realms/<REALM_NAME>
# Must be IDENTICAL to frontend/.env.local KEYCLOAK_ISSUER.
KEYCLOAK_ISSUER=http://localhost:8080/realms/tariq

# Expected `aud` claim on incoming JWTs. Must equal AUDIENCE in .env.docker.
KEYCLOAK_AUDIENCE=tariq-api

# Seconds between JWKS refetches. Raise in prod for fewer round-trips.
KEYCLOAK_JWKS_CACHE_TTL=3600

# Token `exp` leeway in seconds (clock skew tolerance).
KEYCLOAK_CLOCK_SKEW=10

# ---- Auth provider ----
# Two mutually-exclusive auth backends:
#   * keycloak (default) — original RS256 resource-server flow against Keycloak JWKS.
#   * sqlite              — local email+password store, HS256 JWTs issued by this API.
# When `sqlite`, Keycloak is not contacted at startup and the routes
# POST /auth/register and POST /auth/login are exposed under API_PREFIX.
AUTH_PROVIDER=keycloak

# REQUIRED when AUTH_PROVIDER=sqlite. HS256 signing secret, min 32 chars.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=

# `iss` claim baked into locally-issued JWTs.
AUTH_JWT_ISSUER=tariq-backend

# `aud` claim baked into locally-issued JWTs. Default matches KEYCLOAK_AUDIENCE
# so the frontend can share its audience check between the two providers.
AUTH_JWT_AUDIENCE=tariq-api

# Lifetime of locally-issued tokens, in seconds. No refresh-token endpoint —
# clients re-authenticate when the token expires.
AUTH_JWT_TTL_SECONDS=3600

# When false, /auth/register returns 403. /auth/login keeps working for users
# seeded out-of-band.
AUTH_ALLOW_REGISTRATION=true

# ---- CORS ----
# JSON array. In prod, replace with your real frontend origin(s),
# e.g. ["https://app.example.com"].
CORS_ORIGINS=["http://localhost:3000"]
